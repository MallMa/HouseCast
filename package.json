{
  "name": "housecast",
  "productName": "Housecast",
  "version": "0.3.0",
  "description": "Stream your Windows PC audio to the network speakers in every room. Local, free and open source.",
  "private": true,
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "pack": "electron-builder --win dir --x64",
    "dist": "electron-builder --win nsis portable --x64",
    "format": "prettier --write app test scripts/*.mjs package.json",
    "prepack": "node node_modules/electron/install.js",
    "predist": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.63.0",
    "prettier": "3.8.1"
  },
  "build": {
    "appId": "io.github.housecast.desktop",
    "productName": "Housecast",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Housecast-${version}-Windows-portable.exe",
      "unpackDirName": "Housecast"
    },
    "extraResources": [
      {
        "from": "app/platform/allow-home-network.ps1",
        "to": "allow-home-network.ps1"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Housecast-${version}-Windows-Setup.exe",
      "shortcutName": "Housecast",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "author": "Housecast contributors",
  "license": "MIT",
  "keywords": [
    "audio",
    "streaming",
    "upnp",
    "multiroom",
    "desktop-audio",
    "electron",
    "windows"
  ]
}
